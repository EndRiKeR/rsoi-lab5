{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Authority": "https://keycloak.your-domain.ru/realms/<realm-name>",
    "Issuer": "https://keycloak.your-domain.ru",
    "Audience": "gateway-service",
    "RequireHttpsMetadata": true
  },
  "AllowedHosts": "*"
}
